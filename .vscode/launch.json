// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			// Debug server. SHOULD_TEST_IN_RELEASE is set here rather than left to
			// client/.env: dotenv.config() does not overwrite variables that are
			// already in process.env, so the launch config wins and the two F5
			// entries below stay honest about which build they spawn.
			"name": "Run Extension (Debug server)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/client"
			],
			"outFiles": [
				"${workspaceFolder}/client/out/**/*.js"
			],
			"preLaunchTask": "build: debug",
			"env": {
				"VSCODE_DEBUG": "true",
				"SHOULD_TEST_IN_RELEASE": "false"
			}
		},
		{
			// Release server — the configuration users actually get. Reads
			// SERVER_LOCATION from client/.env.
			"name": "Run Extension (Release server)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/client"
			],
			"outFiles": [
				"${workspaceFolder}/client/out/**/*.js"
			],
			"preLaunchTask": "build: release",
			"env": {
				"VSCODE_DEBUG": "true",
				"SHOULD_TEST_IN_RELEASE": "true"
			}
		},
		{
			// Release server, opened on a generated scale workspace under %TEMP%\gscode-scale.
			// scripts\scale-workspace.bat builds one and prints its name; the prompt defaults to bo3
			// at 10,000 files with scripts\zm\_zm.gsc duplicated. The Release server, since Debug
			// timings are not what anyone running 50,000 files would see.
			"name": "Run Extension (scale workspace)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/client",
				"${env:TEMP}/gscode-scale/${input:scaleWorkspace}.code-workspace"
			],
			"outFiles": [
				"${workspaceFolder}/client/out/**/*.js"
			],
			"preLaunchTask": "build: release",
			"env": {
				"VSCODE_DEBUG": "true",
				"SHOULD_TEST_IN_RELEASE": "true"
			}
		}
	],
	"inputs": [
		{
			"id": "scaleWorkspace",
			"type": "promptString",
			"description": "Which generated scale workspace to open, by name (scripts\\scale-workspace.bat prints it)",
			"default": "bo3-10000-zm"
		}
	]
}
