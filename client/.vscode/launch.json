// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
//
// Mirrors ../../.vscode/launch.json for the case where VS Code is opened on the
// client folder rather than the repo root.
{
	"version": "0.2.0",
	"configurations": [
		{
			// Debug server. SHOULD_TEST_IN_RELEASE is set here rather than left to
			// client/.env: dotenv.config() does not overwrite variables that are
			// already in process.env, so the launch config wins and the two F5
			// entries below stay honest about which build they spawn.
			"name": "Run Extension (Debug server)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"preLaunchTask": "build: debug",
			"env": {
				"VSCODE_DEBUG": "true",
				"SHOULD_TEST_IN_RELEASE": "false"
			}
		},
		{
			// Release server — the configuration users actually get. Reads
			// SERVER_LOCATION from client/.env.
			"name": "Run Extension (Release server)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"preLaunchTask": "build: release",
			"env": {
				"VSCODE_DEBUG": "true",
				"SHOULD_TEST_IN_RELEASE": "true"
			}
		}
	]
}
