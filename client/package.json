{
	"name": "gscode",
	"displayName": "GSCode",
	"description": "IntelliSense for Call of Duty: Black Ops III's GSC & CSC languages.",
	"icon": "icons/gscode.png",
	"version": "2.0.0",
	"publisher": "blakintosh",
	"repository": {
		"type": "git",
		"url": "https://github.com/Blakintosh/gscode"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [
		"workspaceContains:**/*.gsc",
		"workspaceContains:**/*.csc",
		"workspaceContains:**/*.gsh"
	],
	"main": "./out/extension.js",
	"contributes": {
		"semanticTokenScopes": [
			{
				"language": "gsc",
				"scopes": {
					"parameter.defaultLibrary": [
						"variable.language"
					],
					"variable.defaultLibrary": [
						"variable.language"
					]
				}
			},
			{
				"language": "csc",
				"scopes": {
					"parameter.defaultLibrary": [
						"variable.language"
					],
					"variable.defaultLibrary": [
						"variable.language"
					]
				}
			}
		],
		"languages": [
			{
				"id": "gsc",
				"aliases": [
					"GSC"
				],
				"extensions": [
					".gsc"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"dark": "./icons/file-gsc.png",
					"light": "./icons/file-gsc.png"
				}
			},
			{
				"id": "csc",
				"aliases": [
					"CSC"
				],
				"extensions": [
					".csc"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"dark": "./icons/file-csc.png",
					"light": "./icons/file-csc.png"
				}
			},
			{
				"id": "gsh",
				"aliases": [
					"GSH"
				],
				"extensions": [
					".gsh"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"dark": "./icons/file-gsh.png",
					"light": "./icons/file-gsh.png"
				}
			}
		],
		"grammars": [
			{
				"language": "gsc",
				"scopeName": "source.gsc",
				"path": "./syntaxes/gsc.tmGrammar.json"
			},
			{
				"language": "csc",
				"scopeName": "source.gsc",
				"path": "./syntaxes/gsc.tmGrammar.json"
			},
			{
				"language": "gsh",
				"scopeName": "source.gsc",
				"path": "./syntaxes/gsc.tmGrammar.json"
			}
		],
		"commands": [
			{
				"command": "gscode.showOutput",
				"title": "GSCode: Show Server Output"
			}
		],
		"configuration": {
			"title": "GSCode",
			"properties": {
				"gscode.serverLogLevel": {
					"type": "string",
					"default": "off",
					"enum": [
						"off",
						"error",
						"warning",
						"info",
						"verbose"
					],
					"enumDescriptions": [
						"No server logging.",
						"Errors only.",
						"Warnings and errors.",
						"General progress information (indexing, cache, lifecycle).",
						"Detailed debug output, including per-request logging."
					],
					"description": "Verbosity of the GSCode language server's log output (the 'GSCode Server' channel). Applies live, no restart needed.",
					"scope": "window"
				},
				"gscode.trace.server": {
					"type": "string",
					"default": "off",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"description": "Trace the LSP protocol traffic between VSCode and the GSCode language server.",
					"scope": "window"
				}
			}
		},
		"configurationDefaults": {
			"[gsc]": {
				"editor.quickSuggestions": {
					"other": "on",
					"comments": "off",
					"strings": "off"
				}
			},
			"[csc]": {
				"editor.quickSuggestions": {
					"other": "on",
					"comments": "off",
					"strings": "off"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src"
	},
	"devDependencies": {
		"@eslint/js": "^9.15.0",
		"@types/node": "^20.17.0",
		"@types/vscode": "^1.85.0",
		"eslint": "^9.15.0",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.15.0"
	},
	"dependencies": {
		"dotenv": "^16.4.5",
		"vscode-languageclient": "^9.0.1"
	}
}
