// Snippets valid in EVERY dialect - contributed to .gsc, .csc and .gsh alike.
//
// A contributed snippet is registered against a language id, and one language id covers five
// games. VS Code merges these into the completion list unconditionally and nothing can withdraw
// one, so a snippet here MUST be valid in all five. That is the whole entry rule for this file.
//
// Anything dialect-specific - foreach, class, new, the function declaration, the ScriptDoc forms,
// and every import directive - is served by the SERVER instead, which is the only side that knows
// the active game. See GscSnippets in GSCode.Workspace/Completion. Those used to live here and
// were offered while editing CoD4, which has none of them.
//
// Bodies are copied from the shape the stock scripts use rather than invented - the brace and
// spacing style matches the formatter's defaults.
//
// #precache lives in precache-server.json and precache-client.json instead, because its asset
// types differ by world. See PrecacheAssetTypes.IsAvailableIn.
{
	"if": {
		"prefix": "if",
		"body": ["if ( ${1:condition} )", "{", "\t$0", "}"],
		"description": "if statement"
	},
	"if else": {
		"prefix": "ifelse",
		"body": ["if ( ${1:condition} )", "{", "\t$2", "}", "else", "{", "\t$0", "}"],
		"description": "if/else statement"
	},
	"if defined": {
		"prefix": "ifdef",
		"body": ["if ( isdefined( ${1:value} ) )", "{", "\t$0", "}"],
		"description": "Guard on isdefined - the standard GSC null check"
	},
	"for": {
		"prefix": "for",
		"body": ["for ( ${1:i} = 0; ${1:i} < ${2:array}.size; ${1:i}++ )", "{", "\t$0", "}"],
		"description": "for loop over an array by index"
	},
	"for reverse": {
		"prefix": "forr",
		"body": ["for ( ${1:i} = ${2:array}.size - 1; ${1:i} >= 0; ${1:i}-- )", "{", "\t$0", "}"],
		"description": "Reverse for loop - the safe way to remove entries while iterating"
	},
	"while": {
		"prefix": "while",
		"body": ["while ( ${1:condition} )", "{", "\t$0", "}"],
		"description": "while loop"
	},
	"switch": {
		"prefix": "switch",
		"body": ["switch ( ${1:value} )", "{", "\tcase ${2:label}:", "\t\t$0", "\t\tbreak;", "\tdefault:", "\t\tbreak;", "}"],
		"description": "switch statement"
	},
	"case": {
		"prefix": "case",
		"body": ["case ${1:label}:", "\t$0", "\tbreak;"],
		"description": "switch case with its break"
	},

	"waittill": {
		"prefix": "waittill",
		"body": ["${1:self} waittill( \"${2:event}\" );"],
		"description": "Wait for a notify"
	},
	"waittill with outputs": {
		"prefix": "waittillargs",
		"body": ["${1:self} waittill( \"${2:event}\", ${3:attacker} );"],
		"description": "Wait for a notify and bind the values it carries"
	},
	"notify": {
		"prefix": "notify",
		"body": ["${1:self} notify( \"${2:event}\" );"],
		"description": "Send a notify"
	},
	"endon": {
		"prefix": "endon",
		"body": ["${1:self} endon( \"${2:event}\" );"],
		"description": "End this thread when the notify fires"
	},
	"thread": {
		"prefix": "thread",
		"body": ["${1:self} thread ${2:function}();"],
		"description": "Run a function on its own thread"
	},
	"wait": {
		"prefix": "wait",
		"body": ["wait ${1:0.05};"],
		"description": "Wait for a number of seconds"
	},
	"assert": {
		"prefix": "assert",
		"body": ["assert( isdefined( ${1:value} ) );"],
		"description": "Assert a condition holds - development builds only"
	},
	"dev block": {
		"prefix": "devblock",
		"body": ["/#", "\t$0", "#/"],
		"description": "Development-only block, stripped from a release build"
	},
	"define": {
		"prefix": "define",
		"body": ["#define ${1:NAME} ${2:value}"],
		"description": "Preprocessor macro"
	}
}
