// #precache for the CLIENT world - contributed to .csc and .gsh.
//
// The client_* family precaches assets the client owns and is the reason this file is separate:
// writing one in a .gsc is a mistake the engine will not honour, and gscode-4006 reports it, so
// the .gsc snippet must not offer them. A .csc can use BOTH families, which is why the shared
// types are repeated here rather than left to the server file.
//
// A .gsh takes this file rather than the server one: a header is inserted into whichever world
// includes it and cannot know which that will be, so it needs the superset - which is exactly what
// this file offers. PrecacheAssetTypes.IsAvailableIn allows a header everything for the same reason.
{
	"precache client (BO3)": {
		"prefix": "precacheclient",
		"body": ["#precache( \"${1|client_fx,client_tagfxset,client_model,client_string|}\", \"${2:asset}\" );"],
		"description": "Precache a client-side asset at load - BO3 .csc only, and never valid in a .gsc"
	},
	"precache (BO3)": {
		"prefix": "precache",
		"body": ["#precache( \"${1|client_fx,client_tagfxset,client_model,client_string,model,xmodel,xmodelalias,fx,material,menu,weapon,vehicle,character,playercharacter,aitype,zbarrier,xcam,destructible,streamerhint,headicon,statusicon,locationselector,objective,rumble,shellshock,lui_menu,lui_menu_data,string,debugstring,eventstring,triggerstring|}\", \"${2:asset}\" );"],
		"description": "Precache an asset at load - BO3 only. A client script may use either family, so both are offered with the client_* types first"
	}
}
