<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-time generator, run by hand with "dotnet run" from this folder.
       Deliberately NOT in GSCode.slnx so it is never a server build/runtime dependency. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GSCode.FieldData</RootNamespace>
  </PropertyGroup>

</Project>
