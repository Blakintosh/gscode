		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.0.0",
		"mdsvex": "^0.12.0",
		"playwright-core": "^1.60.0",
		"prettier": "^3.3.3",
